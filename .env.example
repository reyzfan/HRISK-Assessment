# ─── Supabase / PostgreSQL ──────────────────
# Get these from your Supabase project dashboard: https://supabase.com/dashboard
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ─── Supabase Client ────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─── AI ──────────────────────
# Ollama runs locally — install from https://ollama.ai and run: ollama pull llama3
OLLAMA_BASE_URL="http://localhost:11434"
# Groq is the cloud fallback — get key from https://console.groq.com
GROQ_API_KEY="your-groq-key"

# ─── Email ──────────────────
# Resend free tier = 3,000 emails/month — get key from https://resend.com
RESEND_API_KEY="your-resend-key"
# Use onboarding@resend.dev for limited testing, or your verified sender domain for real campaigns.
RESEND_FROM_EMAIL="onboarding@resend.dev"

# ─── App ─────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
